{
  "name": "bi-dashboard",
  "version": "1.0.0",
  "description": "Business Intelligence Dashboard - Student Productivity & Distraction Analysis",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "setup": "cd backend && npm install && cd ../frontend && npm install",
    "db:init": "cd backend && node ../scripts/setup-db.js",
    "db:import": "cd backend && node ../scripts/import-data.js",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
